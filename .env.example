# Neon Postgres (auto-provisionné par l'intégration Vercel Marketplace)
DATABASE_URL="postgres://<user>:<pass>@<host>/<db>?sslmode=require"
# Vercel Blob (auto-provisionné)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Auth (Better Auth) ---
# Secret de signature. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me"
# Base URL de l'app (sans slash final)
BETTER_AUTH_URL="http://localhost:3000"

# --- Email ---
# Expéditeur (optionnel ; défaut dans lib/email.ts)
EMAIL_FROM="ARTémis Records <no-reply@artemis-records.fr>"
# Transport SMTP (Nodemailer) pour dev + preview.
# Dev : Mailpit en local → localhost:1025 (ce sont déjà les défauts du code).
# Preview : pointer SMTP_* vers un sandbox (Mailtrap / Ethereal).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# Prod uniquement (préparé, pas encore implémenté dans lib/email.ts)
RESEND_API_KEY="re_xxx"
