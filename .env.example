# ==============================================================
# ARTémis Records — modèle de variables d'environnement
# ==============================================================
# Copier vers `.env` (dev local) et remplir. Sur Vercel, saisir les valeurs
# par environnement (Preview / Production) dans Settings → Environment
# Variables — voir le mapping en bas de fichier.

# --- Base de données : Neon Postgres (intégration Vercel Marketplace) ---
# Dev local → connection string POOLED de la branche `dev` du projet Neon.
# ⚠️ L'intégration injecte la branche `main` (prod) dans tous les envs Vercel :
#    surcharger DATABASE_URL en Preview avec la branche `preview`.
DATABASE_URL="postgresql://<user>:<pass>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Vercel Blob (injecté automatiquement sur Vercel ; requis en dev local) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Auth (Better Auth) ---
# Secret de signature, UNIQUE PAR ENVIRONNEMENT. Générer :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me"
# Base URL de l'app, sans slash final (dev: localhost ; preview: alias git ;
# prod: domaine final). Les liens des emails (magic link, invitation) en dépendent.
BETTER_AUTH_URL="http://localhost:3000"

# --- Email ---
# Expéditeur (optionnel ; défaut dans lib/email.ts).
EMAIL_FROM="ARTémis Records <no-reply@artemisrecordslabel.com>"
# Transport SMTP (Nodemailer) pour dev + preview :
# - dev     : Mailpit local → localhost:1025 (défauts du code, webmail :8025)
# - preview : Resend en SMTP → smtp.resend.com:465, user "resend", pass = clé API
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# TLS : auto (implicite sur 465, STARTTLS sinon). Ne renseigner que pour forcer.
SMTP_SECURE=""
# Prod uniquement : Resend via API (lib/email.ts). Domaine vérifié requis côté Resend.
RESEND_API_KEY="re_xxx"

# --- Cron ---
# Protège /api/cron/purge-demos (le cron Vercel envoie `Authorization: Bearer …`).
# Prod uniquement. Générer comme BETTER_AUTH_SECRET.
CRON_SECRET="change-me"

# --- Seed local (scripts/seed.ts, branche dev uniquement) ---
SEED_SUPERADMIN_EMAIL="admin@exemple.fr"

# ==============================================================
# Mapping par environnement (rappel)
# ==============================================================
# | Variable            | Dev local (.env)   | Preview (Vercel)      | Production (Vercel)   |
# |---------------------|--------------------|-----------------------|-----------------------|
# | DATABASE_URL        | branche `dev`      | branche `preview` ⚠️  | branche `main` (auto) |
# | BLOB_READ_WRITE_…   | token du store     | auto (intégration)    | auto (intégration)    |
# | BETTER_AUTH_SECRET  | propre au dev      | propre au preview     | propre à la prod      |
# | BETTER_AUTH_URL     | http://localhost…  | alias git preview     | domaine final         |
# | SMTP_*              | Mailpit (défauts)  | Resend SMTP           | — (RESEND_API_KEY)    |
# | CRON_SECRET         | —                  | —                     | requis                |
